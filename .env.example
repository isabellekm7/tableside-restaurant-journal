# Copy to .env.local (git-ignored) and fill in. Leave blank to run on the bundled sample data only.
#
# Only the project URL and the PUBLISHABLE key belong here. The publishable key is designed to ship in
# browser code; row-level security protects the data. NEVER put a service-role / secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
